{
  "name": "@ceo/world-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && node --check scripts/verify-live-site.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js tests/*.test.mjs",
    "test:browser-smoke": "node scripts/run-real-browser-smoke.mjs && node scripts/run-responsive-browser-smoke.mjs",
    "test:site-negative": "node scripts/test-site-negative.mjs",
    "verify:site": "npm run build:site && npm run test:site-negative && node scripts/verify-site.mjs",
    "verify:production": "node scripts/verify-live-site.mjs",
    "verify": "npm run typecheck && npm test && npm run verify:site",
    "capture:visual-acceptance": "node --import ./scripts/font-policy-preload.mjs scripts/capture-visual-acceptance.mjs && node scripts/apply-font-evidence-policy.mjs"
  },
  "dependencies": { "three": "0.185.1" },
  "devDependencies": { "typescript": "5.9.2", "@types/node": "22.17.2" }
}
