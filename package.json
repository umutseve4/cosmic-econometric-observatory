{
  "name": "@ceo/world-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js tests/*.test.mjs",
    "test:browser-smoke": "node scripts/run-real-browser-smoke.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": { "typescript": "5.9.2", "@types/node": "22.17.2" }
}
